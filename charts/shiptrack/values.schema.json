{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "region", "vpcCidr", "alb", "aws", "api", "workerEvents", "workerNotify", "slaScan", "migrations"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "region": { "type": "string", "minLength": 1 },
    "vpcCidr": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$" },
    "baseUrl": { "type": "string" },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "schemaCompat": { "type": "string", "pattern": "^[0-9A-Za-z_]+(,[0-9A-Za-z_]+)*$" },
    "faultErrorRate": { "type": "string", "pattern": "^(0|1|0?\\.[0-9]+)$" },
    "faultReadyFail": { "type": "boolean" },
    "alb": {
      "type": "object",
      "required": ["targetGroupArn", "securityGroupId"],
      "properties": {
        "targetGroupArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:elasticloadbalancing:[a-z0-9-]+:[^:]+:targetgroup/.+$" },
        "securityGroupId": { "type": "string", "pattern": "^sg-[0-9a-f]{8,17}$" }
      }
    },
    "aws": {
      "type": "object",
      "required": ["eventsQueueUrl", "notifyQueueUrl", "eventBusName", "podBucket", "dbSecretArn", "dbMigratorSecretArn"],
      "properties": {
        "eventsQueueUrl": { "type": "string", "pattern": "^https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/.+$" },
        "notifyQueueUrl": { "type": "string", "pattern": "^https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/.+$" },
        "eventBusName": { "type": "string", "minLength": 1 },
        "podBucket": { "type": "string", "minLength": 3 },
        "dbSecretArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:secretsmanager:.+$" },
        "dbMigratorSecretArn": { "type": "string", "pattern": "^arn:aws[a-z-]*:secretsmanager:.+$" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": { "automountToken": { "type": "boolean" } }
    },
    "api": {
      "type": "object",
      "required": ["hpa", "pool", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "pool": { "$ref": "#/definitions/pool" },
        "hpa": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 2 },
            "maxReplicas": { "type": "integer", "minimum": 2 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 100 },
            "scaleDownStabilizationSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "workerEvents": {
      "type": "object",
      "required": ["keda", "pool"],
      "properties": {
        "pool": { "$ref": "#/definitions/pool" },
        "keda": { "$ref": "#/definitions/keda" }
      }
    },
    "workerNotify": {
      "type": "object",
      "required": ["keda"],
      "properties": { "keda": { "$ref": "#/definitions/keda" } }
    },
    "slaScan": {
      "type": "object",
      "required": ["suspend", "schedule"],
      "properties": {
        "suspend": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 9 },
        "pool": { "$ref": "#/definitions/pool" }
      }
    },
    "migrations": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "pool": { "$ref": "#/definitions/pool" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "definitions": {
    "pool": {
      "type": "object",
      "required": ["size", "maxOverflow"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "maxOverflow": { "type": "integer", "minimum": 0 }
      }
    },
    "keda": {
      "type": "object",
      "required": ["minReplicaCount", "maxReplicaCount", "queueLength"],
      "properties": {
        "minReplicaCount": { "type": "integer", "minimum": 0 },
        "maxReplicaCount": { "type": "integer", "minimum": 1 },
        "queueLength": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
