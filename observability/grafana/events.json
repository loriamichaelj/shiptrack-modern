            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "noValue": "0",
          "min": 0
        },
        "overrides": []
      },
      "description": "applied, duplicate, out_of_order, and error. A duplicate or out-of-order event is expected."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Apply lag p50, p95, p99",
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shiptrack_event_apply_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shiptrack_event_apply_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shiptrack_event_apply_lag_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "noValue": "0",
          "min": 0
        },
        "overrides": []
      }
    },
