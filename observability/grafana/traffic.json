{
  "uid": "shiptrack-traffic",
  "title": "ShipTrack: live traffic",
  "description": "Requests, errors, latency, and the event pipeline, from the managed Prometheus scraper (30 s interval).",
  "tags": [
    "shiptrack",
    "modern"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "shiptrack"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "title": "ShipTrack boards"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(rate(http_requests_total{route!~\"/healthz|/readyz\"}[$__rate_interval])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Requests to the API, without the load balancer's health probes."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server errors",
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "100 * (sum(rate(http_requests_total{status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_requests_total[$__rate_interval])) > 0) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Share of responses that were 5xx."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/healthz|/readyz\"}[$__rate_interval]))) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "noValue": "0",
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events accepted per second",
      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "sum(rate(shiptrack_events_enqueued_total{result=\"ok\"}[$__rate_interval])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
