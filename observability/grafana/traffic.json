      "datasource": {
        "type": "prometheus",
        "uid": "amp"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "amp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shiptrack_event_apply_lag_seconds_bucket[$__rate_interval]))) or vector(0)"
        }
